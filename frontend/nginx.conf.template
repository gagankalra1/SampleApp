# nginx configuration for the VoltMart storefront pod.
#
# This container is the *only* thing in the cluster exposed to the internet.
# It does two jobs:
#
#   1. Serve the built React bundle.
#   2. Reverse proxy /api/<service>/ to the matching ClusterIP service.
#
# Keeping the API on the same origin as the page means no CORS configuration,
# no API hostname baked into the JavaScript bundle, and no second public
# endpoint to secure.
#
# Note what is deliberately absent: there is no route to the payment service.
# The browser has no business talking to it, so it is unreachable from
# outside the cluster. Only the checkout service calls it, pod to pod.
#
# Processed by nginx's envsubst entrypoint at container start, so the upstream
# addresses come from the Deployment's environment rather than being baked in.

# Cluster DNS. Resolving at request time rather than at start-up matters: with
# a static upstream name, nginx refuses to start if a backend Service does not
# exist yet, which turns a first deploy into a CrashLoopBackOff race. The
# default is the kube-dns address for the EKS default service CIDR
# (172.20.0.0/16); override NGINX_RESOLVER if the cluster uses another.
resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
resolver_timeout 5s;

# Real client IP from the ALB, so rate limiting and logs see the caller rather
# than the load balancer.
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# Bound how fast one client can hit the API. The agent endpoint gets its own,
# tighter bucket because each call costs a Bedrock invocation.
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=agent_limit:10m rate=2r/s;
limit_req_status 429;
limit_conn_zone $binary_remote_addr zone=conn_limit:10m;

log_format json_combined escape=json
  '{'
    '"time":"$time_iso8601",'
    '"remote_addr":"$remote_addr",'
    '"method":"$request_method",'
    '"uri":"$uri",'
    '"status":$status,'
    '"bytes":$body_bytes_sent,'
    '"duration":$request_time,'
    '"upstream_status":"$upstream_status",'
    '"upstream_time":"$upstream_response_time",'
    '"user_agent":"$http_user_agent",'
    '"trace_id":"$http_traceparent"'
  '}';

server {
    listen 8080;
    server_name _;

    access_log /dev/stdout json_combined;
    error_log /dev/stderr warn;

    root /usr/share/nginx/html;
    index index.html;

    # Do not advertise the nginx version.
    server_tokens off;

    client_max_body_size 256k;
    limit_conn conn_limit 64;

    # ---- Security headers -------------------------------------------------
    # The CSP has no 'unsafe-eval' and no wildcard script source. Styles need
    # 'unsafe-inline' because the product visuals compute gradients inline;
    # scripts do not, so script-src stays strict.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # ---- Pod health ------------------------------------------------------
    # Answered by nginx itself so a backend outage never restarts this pod.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # ---- Shared proxy behaviour ------------------------------------------
    # Trace context flows through untouched, which is what keeps a browser
    # request and the service spans it causes in one trace.
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    proxy_buffering off;

    # ---- API routes ------------------------------------------------------
    location ~ ^/api/catalog/(.*)$ {
        limit_req zone=api_limit burst=60 nodelay;
        set $upstream_catalog ${CATALOG_UPSTREAM};
        proxy_pass $upstream_catalog/$1$is_args$args;
    }

    location ~ ^/api/inventory/(.*)$ {
        limit_req zone=api_limit burst=60 nodelay;
        set $upstream_inventory ${INVENTORY_UPSTREAM};
        proxy_pass $upstream_inventory/$1$is_args$args;
    }

    location ~ ^/api/cart/(.*)$ {
        limit_req zone=api_limit burst=60 nodelay;
        set $upstream_cart ${CART_UPSTREAM};
        proxy_pass $upstream_cart/$1$is_args$args;
    }

    location ~ ^/api/orders/(.*)$ {
        limit_req zone=api_limit burst=60 nodelay;
        set $upstream_orders ${ORDERS_UPSTREAM};
        proxy_pass $upstream_orders/$1$is_args$args;
    }

    location ~ ^/api/checkout/(.*)$ {
        limit_req zone=api_limit burst=20 nodelay;
        set $upstream_checkout ${CHECKOUT_UPSTREAM};
        # A checkout crosses four services and takes a simulated payment, so
        # it gets a longer read timeout than an ordinary API call.
        proxy_read_timeout 60s;
        proxy_pass $upstream_checkout/$1$is_args$args;
    }

    location ~ ^/api/support/(.*)$ {
        # Each call here invokes a foundation model, so the bucket is tight and
        # the timeout is long: the agent may chain several tool calls before it
        # answers.
        limit_req zone=agent_limit burst=5 nodelay;
        set $upstream_agent ${AGENT_UPSTREAM};
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_pass $upstream_agent/$1$is_args$args;
    }

    # Anything else under /api is not a route we publish.
    location /api/ {
        return 404 '{"error":{"code":"not_found","message":"No such API route."}}';
        add_header Content-Type application/json always;
    }

    # ---- Static assets ---------------------------------------------------
    # Vite emits content-hashed filenames, so these are safe to cache forever.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    location ~* \.(svg|png|jpg|jpeg|gif|ico|webp|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public";
        access_log off;
        try_files $uri =404;
    }

    # ---- SPA fallback ----------------------------------------------------
    # index.html is never cached, so a new deploy is picked up immediately
    # even though the hashed assets around it are cached hard.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, must-revalidate";
    }
}
